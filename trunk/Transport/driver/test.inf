[Version]
Signature   = "$Windows NT$"
Class       = "ContentScreener"                         ;This is determined by the work this filter driver does
ClassGuid   = {3e3f0674-c83c-4558-bb26-9820e1eba5c5}    ;This value is determined by the Class
Provider    = %ProviderString%
DriverVer   = 12/09/2019,1.0.0.0
CatalogFile = test.cat
PnpLockdown = 1


[DestinationDirs]
DefaultDestDir       = 12
test.DriverFiles     = 12            ;%windir%\system32\drivers


[DefaultInstall.NTamd64]
OptionDesc          = %ServiceDescription%
CopyFiles           = test.DriverFiles
; Write legacy Instances path here (outside service AddReg) to satisfy infverif
; while keeping compatibility with Windows versions before Win11 24H2
AddReg             = test.LegacyInstances


[DefaultInstall.NTamd64.Services]
AddService          = %ServiceName%,,test.Service


[test.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys        ;%windir%\system32\drivers\
Dependencies     = "FltMgr"
ServiceType      = 2                            ;SERVICE_FILE_SYSTEM_DRIVER
StartType        = 1                            ;SERVICE_SYSTEM_START
ErrorControl     = 1                            ;SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Content Screener"
AddReg           = test.AddRegistry


[test.AddRegistry]
; Win11 24H2+ required path, also checked by infverif
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\%Instance1.Name%","Altitude",0x00000000,%Instance1.Altitude%
HKR,"Parameters\Instances\%Instance1.Name%","Flags",0x00010001,%Instance1.Flags%


[test.LegacyInstances]
; Legacy Instances path: required by FltMgr on Windows versions before Win11 24H2
; Written via HKLM absolute path so infverif does not flag it as a service key violation
HKLM,"System\CurrentControlSet\Services\%ServiceName%\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKLM,"System\CurrentControlSet\Services\%ServiceName%\Instances\%Instance1.Name%","Altitude",0x00000000,%Instance1.Altitude%
HKLM,"System\CurrentControlSet\Services\%ServiceName%\Instances\%Instance1.Name%","Flags",0x00010001,%Instance1.Flags%


[test.DriverFiles]
%DriverName%.sys


[SourceDisksFiles]
test.sys = 1,,


[SourceDisksNames]
1 = %DiskId1%,,,


[Strings]
ProviderString          = "TODO-Set-Provider"
ServiceDescription      = "test mini-filter driver"
ServiceName             = "test"
DriverName              = "test"
DiskId1                 = "test Device Installation Disk"

DefaultInstance         = "test Instance"
Instance1.Name          = "test Instance"
Instance1.Altitude      = "371100"
Instance1.Flags         = 0x0          ; Allow all attachments
